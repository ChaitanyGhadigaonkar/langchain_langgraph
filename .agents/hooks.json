{
  "frontend-auto-format": {
    "enabled": true,
    "PostToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "bash .agents/hooks/lint-file.sh",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "frontend-completion-check": {
    "enabled": true,
    "Stop": [
      {
        "type": "command",
        "command": "bash .agents/hooks/stop-check.sh",
        "timeout": 60
      }
    ]
  }
}
